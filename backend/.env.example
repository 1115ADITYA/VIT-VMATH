# =========================================================================
# VMATH BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to a new file named '.env' and fill in your actual values.
# =========================================================================

# The port you want the backend to listen on (Default: 5000)
PORT=5000

# Your OpenRouter API Key (Get one from https://openrouter.ai/)
# REQUIRED: The chatbot will not function without this key.
API_KEY=your_openrouter_api_key_here

# The AI Model to use for chat tutoring (Default: google/gemini-2.5-flash)
# You can see available models at: https://openrouter.ai/models
AI_MODEL=google/gemini-2.5-flash
